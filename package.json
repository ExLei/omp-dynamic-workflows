{
  "name": "omp-dynamic-workflows",
  "version": "0.1.0",
  "description": "OMP-native dynamic workflow orchestration with model routing, persistence, worktree isolation, and interactive workflow controls.",
  "type": "module",
  "module": "./src/index.ts",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "bun test tests"
  },
  "omp": {
    "extensions": [
      "extensions/workflow.ts"
    ],
    "skills": [
      "skills/workflow-authoring",
      "skills/workflow-patterns"
    ]
  },
  "dependencies": {
    "acorn": "^8.16.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=17.2.4",
    "@oh-my-pi/pi-coding-agent": ">=17.2.4",
    "@oh-my-pi/pi-tui": ">=17.2.4",
    "@oh-my-pi/pi-utils": ">=17.2.4"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.2.4",
    "@oh-my-pi/pi-coding-agent": "17.2.4",
    "@oh-my-pi/pi-tui": "17.2.4",
    "@oh-my-pi/pi-utils": "17.2.4",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
