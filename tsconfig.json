{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false
  },
  "include": ["index.ts", "src/**/*.ts", "extensions/**/*.ts", "tests/**/*.ts", "spike/**/*.ts"]
}
